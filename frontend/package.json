{
  "name": "premium-llm-gateway-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public-facing UI + /v1 proxy for the premium LLM gateway. Deploys to Railway, talks to LiteLLM on RunPod.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
