# =============================================================================
# Frontend (Railway) — environment configuration
# Copy to `.env` for local dev. On Railway, set these as Service Variables.
# =============================================================================

# Public URL of the LiteLLM proxy on RunPod, including https.
# Get this from the RunPod pod's "Connect → HTTP Service" panel after exposing
# port 4000. Example: https://pbm6glpnsw58mc-4000.proxy.runpod.net
LITELLM_URL=https://REPLACE_WITH_RUNPOD_HTTP_URL

# LiteLLM master key (admin). Same value as in premium-llm-gateway/.env on RunPod.
# Used by this service to mint virtual keys via /key/generate. Never exposed
# to the browser or to /v1 clients.
LITELLM_MASTER_KEY=sk-admin-replace-me

# Password for the admin UI on Railway. Anyone with this password can mint
# virtual keys, so treat it like a master credential. Choose something strong.
ADMIN_PASSWORD=replace_with_strong_passphrase

# Random hex string used to sign session cookies. Generate with:
#   openssl rand -hex 32
# If unset, a random one is generated at boot (sessions reset on every redeploy).
SESSION_SECRET=

# Bind port. Railway injects this automatically; only matters for local dev.
PORT=3000
