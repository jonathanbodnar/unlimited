# =============================================================================
# Premium LLM Gateway — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# =============================================================================

# ---------- Postgres (LiteLLM persistent store) ----------
POSTGRES_PASSWORD=replace_me

# ---------- LiteLLM admin / master ----------
# Used only for admin operations (generating virtual keys, etc).
# DO NOT put this key in Cursor or any client.
LITELLM_MASTER_KEY=sk-admin-replace-me

# ---------- Hosted model providers ----------
# Required for Phase 1 premium-user cost test.
DEEPSEEK_API_KEY=replace_me
MIMO_API_KEY=replace_me

# Optional benchmark / rescue providers. Leave blank if not used.
ANTHROPIC_API_KEY=replace_me_optional
OPENAI_API_KEY=replace_me_optional

# ---------- Observability (Langfuse) ----------
# Use Langfuse Cloud unless there's a reason to self-host.
LANGFUSE_PUBLIC_KEY=replace_me
LANGFUSE_SECRET_KEY=replace_me
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Routing mode ----------
# Used by the daily_report.py annotation only — actual routing is decided by
# whichever litellm_config.yaml is mounted into the container.
# One of: A | B | C
ACTIVE_MODE=A

# ---------- Reverse proxy / public URL (optional) ----------
# Only used when running behind Caddy/Nginx. Not consumed by docker-compose.
PUBLIC_HOSTNAME=api.yourdomain.com
